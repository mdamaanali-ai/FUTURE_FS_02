# MySQL connection string.
# If your host requires TLS (TiDB Cloud, Aiven, ...), add ?ssl={"rejectUnauthorized":true} to the end.
DATABASE_URL=mysql://user:password@host:3306/leaddesk

# Signs the admin session cookie. Use a random string of 32+ characters.
# PowerShell:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# The single admin account used to sign in at /login.
ADMIN_EMAIL=
ADMIN_PASSWORD=
